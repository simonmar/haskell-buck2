# Build-wide configuration. Note that settings local to your build
# should go into `.buckconfig.local` which is typically not a tracked
# file.

[cells]
  root = .
  prelude = buck2/prelude
  toolchains = buck2/toolchains
  third-party-haskell = third-party/haskell
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  buck = none

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default \
    target:third-party-haskell//...->prelude//platforms:default

[build]
  execution_platforms = root//buck2/platforms:exec

# Things that affect how Haskell code is built.
[haskell]
  # Extra flags
  #
  # You can add extra flags to compiles and links for the whole
  # build. These flags will come early on the command line, so they
  # will be overriden by target-specific flags.
  #
  #   compiler_flags = -I/opt/homebrew/include
  #   linker_flags = -L/opt/homebrew/lib -L/opt/zlib/lib

  # Per-module compilation
  #
  # See "Per-module compilation" in buck2/README.md for details.
  #
  # Use per-module for all targets:
  #
  #   compile_granularity = module
  #
  # By default per-module compiles use the persistent worker. To disable it:
  #
  #   per_module_worker = none
  #
  # Configure the persistent worker (see buck2/README.md):
  #
  #   per_module_worker_rts_options = -A64m -n4m -qn8 -I5
  #   per_module_worker_sessions = 8
  #   per_module_worker_session_mode = make
