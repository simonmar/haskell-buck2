cabal-version:      3.0
name:               ghc-worker
version:            0.1.0.0
synopsis:           A buck2 persistent worker that compiles modules in long-lived GHC sessions
description:
  See README.md. buck2 sends the worker one request for each module of a
  per-module target, for many targets. The worker compiles each module as it
  arrives, concurrently with the others, with GHC's own compile of one module.
  It keeps a GHC session for each set of flags, which keeps what it has read
  (interfaces, loaded libraries), as `ghc --make -j` does for a package. It
  writes each module's ABI hash and buck2 dep file from the interface GHC
  produced.
license:            MIT
build-type:         Simple
tested-with:        GHC==9.14.1, GHC==9.12.4, GHC==9.10.3, GHC==9.8.4, GHC==9.6.7

-- The worker's modules, which the test suites and benchmark share. Contract,
-- DepFile, Imports, Interface and Request are symlinks to modules of the
-- rules' own tools (prelude/haskell/tools/ghc-api), which the worker shares.
library
  exposed-modules:  Compat, Contract, DepFile, Grpc, Imports, Interface, Proto, Request, Session, Worker
  hs-source-dirs:   src
  default-language: GHC2021
  ghc-options:      -Wall
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , ghc >= 9.6 && < 9.15
    , http2 >= 5.3.7
    , http-types
    , network
    , process, unix

executable ghc-worker
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2021
  -- Defaults for a worker run outside the rules. The rules override -A and
  -- -qn for the shared worker (see per_module_worker_rts_options in
  -- toolchains/per_module_worker.bzl). --disable-delayed-os-memory-return
  -- makes the memory of dropped sessions (see Worker.hs) leave the process
  -- at once. With the default (MADV_FREE), it stays counted against the
  -- process until the kernel needs it.
  ghc-options:      -Wall -threaded -dynamic -rtsopts "-with-rtsopts=-N -A16m -qn4 --disable-delayed-os-memory-return"
  build-depends:
    , base
    , bytestring
    , ghc
    , ghc-worker
    , unix

-- Compiles a small package through the built worker.
test-suite spec
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  other-modules:    Client
  default-language: GHC2021
  ghc-options:      -Wall -threaded
  build-tool-depends: ghc-worker:ghc-worker
  build-depends:
    , base
    , bytestring
    , ghc-worker
    , directory
    , filepath
    , http2 >= 5.3.7
    , http-types
    , network
    , process
    , tasty >= 1.5.1
    , tasty-hunit
    , unix

-- Property tests: generated histories of a package built through the built
-- worker, compared with clean `ghc -c` builds. See props/Main.hs.
test-suite props
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   props, test
  other-modules:    Client
  default-language: GHC2021
  ghc-options:      -Wall -threaded
  build-tool-depends: ghc-worker:ghc-worker
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , ghc-worker
    , hedgehog >= 1.4
    , http2 >= 5.3.7
    , http-types
    , network
    , process
    , tasty >= 1.5.1
    , tasty-hedgehog >= 1.4
    , unix

-- Builds generated packages through the built worker and with `ghc --make`,
-- and reports the time each takes: see bench/Main.hs.
benchmark bench
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   bench, test
  other-modules:    Client
  default-language: GHC2021
  ghc-options:      -Wall -threaded
  build-tool-depends: ghc-worker:ghc-worker
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , ghc-worker
    , http2 >= 5.3.7
    , http-types
    , network
    , process
    , unix
