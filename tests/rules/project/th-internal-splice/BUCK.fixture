load("//buck2:haskell.bzl", "haskell_binary", "haskell_library")
load("//compile:defs.bzl", "PER_MODULE")

# A splice of P.Use runs P.Gen, of the same library.
haskell_library(
    name = "th-internal-splice",
    srcs = {
        "P.Gen": "P/Gen.hs",
        "P.Use": "P/Use.hs",
    },
    packages = ["base", "template-haskell"],
    per_module = PER_MODULE,
)

# The documentation of the library. Haddock runs P.Use's splice, which runs
# P.Gen, as the compile does.
haskell_haddock(
    name = "docs",
    deps = [":th-internal-splice"],
)

# Prints P.Use's use, in each build mode.
haskell_binary(
    name = "use",
    srcs = {"Main": "Main.hs"},
    packages = ["base"],
    deps = [":th-internal-splice"],
    per_module = PER_MODULE,
)

# The library again, linked statically only. Its static compile makes no
# dynamic objects, so GHC's internal interpreter can't load P.Gen for P.Use's
# splice (see check_own_splices_static).
haskell_library(
    name = "static",
    srcs = {
        "P.Gen": "P/Gen.hs",
        "P.Use": "P/Use.hs",
    },
    packages = ["base", "template-haskell"],
    preferred_linkage = "static",
    per_module = True,
)

# Linked statically whatever the mode, as a binary linked shared can't
# depend on the library.
haskell_binary(
    name = "static-main",
    srcs = {"Main": "Main.hs"},
    packages = ["base"],
    deps = [":static"],
    link_style = "static",
    per_module = True,
)

# A binary whose splice (in Main) runs a module of its own, P.Gen. In a
# static build its compiles make no dynamic objects either.
haskell_binary(
    name = "own",
    srcs = {
        "Main": "Own.hs",
        "P.Gen": "P/Gen.hs",
    },
    packages = ["base", "template-haskell"],
    per_module = True,
)

# A binary whose splice (in Main) runs P.LibGen, a module of its own that
# uses //lib:lib, so splice_depends lists //lib:lib.
haskell_binary(
    name = "own-lib",
    srcs = {
        "Main": "OwnLib.hs",
        "P.LibGen": "P/LibGen.hs",
    },
    packages = ["base", "template-haskell"],
    deps = ["//lib:lib"],
    splice_depends = ["//lib:lib"],
    per_module = PER_MODULE,
)
