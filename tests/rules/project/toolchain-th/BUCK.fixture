load("//buck2:haskell.bzl", "haskell_library")

# A splice in a module without a LANGUAGE pragma: it runs Template Haskell
# only where the toolchain's flags enable it, as check_toolchain_th has
# them.
haskell_library(
    name = "toolchain-th",
    srcs = {"TF.M": "TF/M.hs"},
    packages = ["base", "template-haskell"],
    per_module = True,
    visibility = ["PUBLIC"],
)
