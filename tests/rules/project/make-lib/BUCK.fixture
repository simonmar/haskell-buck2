load("//buck2:haskell.bzl", "haskell_library")

# Compiled with --make, so Q.Lib's interface is .../Q/Lib.hi, a path that ends
# as //flat-sources:flat-sources's flat module Lib's would. The rules must not
# take it for Lib's (see _read_deps_makefile); if they do, flat-sources fails
# to build.
haskell_library(
    name = "make-lib",
    srcs = {"Q.Lib": "Q/Lib.hs"},
    packages = ["base"],
    visibility = ["PUBLIC"],
)
