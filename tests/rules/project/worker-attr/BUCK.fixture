load("//buck2:haskell.bzl", "haskell_library")
load("//buck2:worker.bzl", "haskell_per_module_worker")
load("//build-tools:defs.bzl", "exe")

# A target that names its own worker, as cabal.bzl makes every per-module
# target do when the project builds the worker from source
# (`per_module_worker = local`). It is only built when BUCK2_GHC_WORKER is set,
# and run.sh links that worker here as buck2-ghc-worker.
exe(
    name = "buck2-ghc-worker",
    exe = "buck2-ghc-worker",
)

haskell_per_module_worker(
    name = "w",
    worker = ":buck2-ghc-worker",
)

haskell_library(
    name = "worker-attr",
    srcs = {"WK.M": "WK/M.hs"},
    packages = ["base"],
    per_module = True,
    per_module_worker = ":w",
)
