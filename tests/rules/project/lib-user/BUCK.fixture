load("//buck2:haskell.bzl", "haskell_library")
load("//compile:defs.bzl", "PER_MODULE")

haskell_library(
    name = "lib-user",
    # B.Lit: a literate source, whose instance B.UsesLit uses.
    # B.Safe: a Safe module.
    srcs = {"B.Lit": "B/Lit.lhs", "B.M": "B/M.hs", "B.Safe": "B/Safe.hs", "B.UsesLit": "B/UsesLit.hs"},
    packages = ["base"],
    deps = ["//lib:lib"],
    per_module = PER_MODULE,
    visibility = ["PUBLIC"],
)
