load("//buck2:haskell.bzl", "haskell_binary", "haskell_library")
load(":defs.bzl", "run_tool")
load("//compile:defs.bzl", "PER_MODULE")

# l is built in two configurations in one build, with the same unit id and
# soname in both. Its v is 4 in the execution platform's configuration, and
# 3 in the target platform's. tool's splice runs l's code in the execution
# platform's configuration (tool is a build tool, which gen runs), and
# user's splice runs it in the target platform's.
#
# l and tool are built with --make whatever the checks ask for: tool is built
# in the execution platform's configuration, which the //compile:make
# modifier doesn't reach, and per_module doesn't support its splice.
haskell_library(
    name = "l",
    srcs = {"L.V": "L/V.hs"},
    packages = ["base"],
    compiler_flags = select({
        "DEFAULT": [],
        "prelude//cfg/exec_platform/marker:is_exec_platform[true]": ["-DEXEC"],
    }),
    per_module = False,
)

haskell_binary(
    name = "tool",
    srcs = {"Main": "Tool.hs"},
    packages = ["base", "template-haskell"],
    deps = [":l"],
    per_module = False,
)

run_tool(
    name = "gen",
    out = "gen.txt",
    tool = ":tool",
)

haskell_library(
    name = "user",
    srcs = {"U.S": "U/S.hs"},
    packages = ["base", "template-haskell"],
    deps = [":l"],
    per_module = PER_MODULE,
)

# Prints U.S's splice.
haskell_binary(
    name = "show",
    srcs = {"Main": "Show.hs"},
    packages = ["base"],
    deps = [":user"],
    per_module = PER_MODULE,
)
