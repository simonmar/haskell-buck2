load("//buck2:haskell.bzl", "haskell_binary", "haskell_library")
load("//compile:defs.bzl", "COMPILE_GRANULARITY")

# Splices that run modules of their own targets, which call those targets'
# C libraries (c-a for a, c-b for b). When a and b are built at once, their
# modules compile in one worker, which has to load each target's own
# libraries.
cxx_library(
    name = "c-a",
    srcs = ["a.c"],
    preferred_linkage = "shared",
)

cxx_library(
    name = "c-b",
    srcs = ["b.c"],
    preferred_linkage = "shared",
)

haskell_library(
    name = "a",
    srcs = {"A.C": "A/C.hs", "A.S": "A/S.hs"},
    packages = ["base", "template-haskell"],
    deps = [":c-a"],
    compile_granularity = COMPILE_GRANULARITY,
)

haskell_library(
    name = "b",
    srcs = {"B.C": "B/C.hs", "B.S": "B/S.hs"},
    packages = ["base", "template-haskell"],
    deps = [":c-b"],
    compile_granularity = COMPILE_GRANULARITY,
)

# Prints A.S's and B.S's splices.
haskell_binary(
    name = "show",
    srcs = {"Main": "Show.hs"},
    packages = ["base"],
    deps = [":a", ":b"],
    compile_granularity = COMPILE_GRANULARITY,
)
