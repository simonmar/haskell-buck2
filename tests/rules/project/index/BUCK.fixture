load("//buck2:haskell.bzl", "haskell_library")
load("//compile:defs.bzl", "PER_MODULE")

# Built with -fwrite-ide-info, for an index of its .hie files.
haskell_library(
    name = "index",
    srcs = {
        "Idx.A": "Idx/A.hs",
        "Idx.B": "Idx/B.hs",
    },
    compiler_flags = ["-fwrite-ide-info"],
    packages = ["base"],
    per_module = PER_MODULE,
    visibility = ["PUBLIC"],
)
