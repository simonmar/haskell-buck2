load("//buck2:haskell.bzl", "haskell_library")
load("//compile:defs.bzl", "PER_MODULE")

# Depends on th-gen, but its splice runs only template-haskell's code.
haskell_library(
    name = "th-prebuilt-splice",
    srcs = {"D.Splice": "D/Splice.hs"},
    packages = ["base", "template-haskell"],
    deps = ["//lib:lib", "//th-gen:th-gen"],
    per_module = PER_MODULE,
    visibility = ["PUBLIC"],
)
