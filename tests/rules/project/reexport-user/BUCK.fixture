load("//buck2:haskell.bzl", "haskell_library")
load("//compile:defs.bzl", "PER_MODULE")

# Imports A.Base, which its one dependency, reexport, re-exports from lib.
haskell_library(
    name = "reexport-user",
    srcs = {"U.M": "U/M.hs"},
    packages = ["base"],
    deps = ["//reexport:reexport"],
    per_module = PER_MODULE,
)
