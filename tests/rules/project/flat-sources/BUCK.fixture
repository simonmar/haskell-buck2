load("//buck2:haskell.bzl", "haskell_library")

# Flat sources: Lib imports User, which imports Q.Lib from //make-lib:make-lib.
# Lib is not Q.Lib, though Q.Lib's interface path ends in /Lib.hi.
haskell_library(
    name = "flat-sources",
    srcs = {
        "Lib": "Lib.hs",
        "User": "User.hs",
    },
    packages = ["base"],
    deps = ["//make-lib:make-lib"],
    per_module = True,
    visibility = ["PUBLIC"],
)
