load("//buck2:haskell.bzl", "haskell_library")

# A library with a warning in D.Warn, compiled per-module and with --make.
[
    haskell_library(
        name = name,
        srcs = {"D.Other": "D/Other.hs", "D.Warn": "D/Warn.hs"},
        packages = ["base"],
        compiler_flags = ["-Wunused-local-binds"],
        compile_granularity = granularity,
    )
    for name, granularity in [("per-module", "module"), ("make", "target")]
]
