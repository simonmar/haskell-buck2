load("//buck2:haskell.bzl", "haskell_library")
load("//compile:defs.bzl", "PER_MODULE")

# Preprocessors (run with -pgmF), which the libraries below use as build
# tools. bt-own ignores its input and writes a fixed module. bt-copy copies
# its input unchanged.
sh_binary(
    name = "bt-own",
    main = "bt-own",
)

sh_binary(
    name = "bt-copy",
    main = "bt-copy",
)

# Only BT.Own runs bt-own, from its OPTIONS_GHC pragma. BT.OwnPlain runs no
# program. BT.OwnSplice runs Template Haskell, whose splices could run any
# program on PATH.
haskell_library(
    name = "own",
    srcs = {
        "BT.Own": "BT/Own.hs",
        "BT.OwnPlain": "BT/OwnPlain.hs",
        "BT.OwnSplice": "BT/OwnSplice.hs",
    },
    packages = ["base", "template-haskell"],
    build_tool_depends = [":bt-own"],
    per_module = True,
)

# Every module runs bt-copy, because the target's own flags say so.
haskell_library(
    name = "flags",
    srcs = {"BT.Flags": "BT/Flags.hs"},
    packages = ["base"],
    compiler_flags = ["-F", "-pgmF", "bt-copy"],
    build_tool_depends = [":bt-copy"],
    per_module = True,
)

# BT.Disc's preprocessor, bt-discover, finds the modules in BT/Disc as
# hspec-discover finds the specs: by listing the directory, not through
# anything that the compile names.
sh_binary(
    name = "bt-discover",
    main = "bt-discover",
)

haskell_library(
    name = "discover",
    srcs = {"BT.Disc": "BT/Disc.hs", "BT.Disc.A": "BT/Disc/A.hs"},
    packages = ["base"],
    build_tool_depends = [":bt-discover"],
    per_module = PER_MODULE,
)
