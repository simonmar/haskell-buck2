load("//buck2:haskell.bzl", "haskell_binary", "haskell_library")
load("//compile:defs.bzl", "PER_MODULE")

# C.Splice's splice runs TH.Gen, of //th-gen:th-gen. per_module doesn't
# support that, so compiled per-module, C.Splice's compile fails. With
# --make, it compiles.
haskell_library(
    name = "th-local-splice",
    srcs = {
        "C.Ann": "C/Ann.hs",
        "C.Plain": "C/Plain.hs",
        "C.Splice": "C/Splice.hs",
    },
    packages = ["base", "template-haskell"],
    deps = ["//lib:lib", "//th-gen:th-gen"],
    per_module = PER_MODULE,
    visibility = ["PUBLIC"],
)

# Prints C.Splice's splice, to see that it follows TH.Gen.
haskell_binary(
    name = "show",
    srcs = {"Main": "Show.hs"},
    packages = ["base"],
    deps = [":th-local-splice"],
    per_module = PER_MODULE,
)
