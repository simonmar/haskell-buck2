# Prints the path of a library's index (HaskellIndexInfo), built: the tree
# that an indexer reads the .hie files from. With --make true, the library is
# built with --make (see compile/BUCK.fixture), since BXL doesn't take a
# target's modifiers.
load("@prelude//haskell:haskell.bzl", "HaskellIndexInfo")
load("@prelude//linking:link_info.bzl", "LinkStyle")

def _impl(ctx):
    modifiers = ["root//compile:make"] if ctx.cli_args.make else []
    info = ctx.analysis(ctx.configured_targets(ctx.cli_args.target, modifiers = modifiers)).providers()[HaskellIndexInfo]
    tset = info.info[LinkStyle("shared")]
    ctx.output.print(ctx.output.ensure(tset.value).abs_path())

index = bxl_main(
    impl = _impl,
    cli_args = {"target": cli_args.target_label(), "make": cli_args.bool(False)},
)
