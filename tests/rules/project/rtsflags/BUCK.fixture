load("//buck2:haskell.bzl", "haskell_library")
load("//compile:defs.bzl", "COMPILE_GRANULARITY")

# Options for GHC's runtime among the compiler flags.
haskell_library(
    name = "rtsflags",
    srcs = {"R.A": "R/A.hs"},
    packages = ["base"],
    compiler_flags = ["+RTS", "-A16m", "-RTS"],
    compile_granularity = COMPILE_GRANULARITY,
)
