load("//buck2:haskell.bzl", "haskell_binary", "haskell_library")
load("//compile:defs.bzl", "PER_MODULE")

# Template Haskell modules whose targets depend on //make-lib:make-lib,
# which is built with --make.
#
# - MK.Lit's splice runs only template-haskell's code, and
#   splice_depends leaves make-lib out. So MK.Lit compiles against
#   make-lib's library-less db, without loading make-lib's library.
# - MK.Run's splice runs make-lib's code, and its target, mkrun, lists
#   make-lib in splice_depends.
# - MK.Miss's splice runs make-lib's code too, but its target, mkmiss,
#   leaves make-lib out of splice_depends. So MK.Miss fails to
#   compile.
# - The splice_depends of mkbad names //lib:lib, which isn't one of
#   its dependencies, so the target's analysis fails.
haskell_library(
    name = "th-make-dep",
    srcs = {"MK.Lit": "MK/Lit.hs"},
    packages = ["base", "template-haskell"],
    deps = ["//make-lib:make-lib"],
    splice_depends = [],
    per_module = PER_MODULE,
    visibility = ["PUBLIC"],
)

# Prints MK.Lit's lit, in each build mode (see check_th_modes).
haskell_binary(
    name = "lit",
    srcs = {"Main": "Lit.hs"},
    packages = ["base"],
    deps = [":th-make-dep"],
    per_module = PER_MODULE,
)

haskell_library(
    name = "mkrun",
    srcs = {"MK.Run": "MK/Run.hs"},
    packages = ["base", "template-haskell"],
    deps = ["//make-lib:make-lib"],
    splice_depends = ["//make-lib:make-lib"],
    per_module = PER_MODULE,
    visibility = ["PUBLIC"],
)

haskell_library(
    name = "mkmiss",
    srcs = {"MK.Miss": "MK/Miss.hs"},
    packages = ["base", "template-haskell"],
    deps = ["//make-lib:make-lib"],
    splice_depends = [],
    per_module = True,
    visibility = ["PUBLIC"],
)

# mkmiss-after is like mkmiss, except that MK.MissAfter imports MK.Load, of
# mkload. So MK.MissAfter compiles after MK.Load, whose splice loads
# make-lib's library. MK.MissAfter should still fail to compile, because a
# splice mustn't be able to use a library that another target's splice
# loaded. In the worker, where both modules compile in the same process, it
# doesn't yet: check_unlisted_th_dependency_fails_after_load is a known
# failure there. Nothing else builds mkload, so MK.Load compiles in the same
# build as MK.MissAfter.
haskell_library(
    name = "mkload",
    srcs = {"MK.Load": "MK/Load.hs"},
    packages = ["base", "template-haskell"],
    deps = ["//make-lib:make-lib"],
    splice_depends = ["//make-lib:make-lib"],
    per_module = True,
)

haskell_library(
    name = "mkmiss-after",
    srcs = {"MK.MissAfter": "MK/MissAfter.hs"},
    packages = ["base", "template-haskell"],
    deps = ["//make-lib:make-lib", ":mkload"],
    splice_depends = [],
    per_module = True,
)

haskell_library(
    name = "mkbad",
    srcs = {"MK.Bad": "MK/Bad.hs"},
    packages = ["base", "template-haskell"],
    deps = ["//make-lib:make-lib"],
    splice_depends = ["//lib:lib"],
    per_module = True,
    visibility = ["PUBLIC"],
)
