load("@prelude//haskell:ghc_api_tool.bzl", "GHC_API_TOOLS", "ghc_api_tool_sources", "haskell_ghc_api_tool")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("build_infra")

source_listing()

prelude = native

prelude.python_bootstrap_binary(
    name = "script_template_processor",
    main = "script_template_processor.py",
    visibility = ["PUBLIC"],
)

# The tools of the per-module compiles (see compile_per_module in
# prelude/haskell/compile_per_module.bzl), built with the toolchain's GHC.
[
    haskell_ghc_api_tool(
        name = name,
        srcs = ghc_api_tool_sources(),
        main = main + ".hs",
        visibility = ["PUBLIC"],
    )
    for name, main in GHC_API_TOOLS.items()
]

# The tools' sources, for a toolchain that builds the tools itself (see
# ghc_api_tool_srcs()).
[
    prelude.export_file(
        name = src,
        visibility = ["PUBLIC"],
    )
    for src in ghc_api_tool_sources()
]

# Type checking target for Python tool scripts
prelude.python_library(
    name = "scripts-typing",
    srcs = [
        "script_template_processor.py",
    ],
    typing = True,
)
