load("@prelude//decls:toolchains_common.bzl", "toolchains_common")
load("@prelude//haskell:toolchain.bzl", "HaskellToolchainInfo")

# Rule to build a local tool that uses the GHC API. It has to be able
# to read .hi files generated by the toolchain's GHC, so it must be
# built by the same GHC. It can only depend on GHC and GHC's built-in
# packages. We can't use haskell rules to build it because that would
# be a cyclic dependency, hence this rather horrible hand-crafted
# rule.
#
# The program is passed GHC's libdir at compile time via the CPP macro
# GHC_LIBDIR.

def _haskell_ghc_api_tool_impl(ctx: AnalysisContext) -> list[Provider]:
    haskell_toolchain = ctx.attrs._haskell_toolchain[HaskellToolchainInfo]
    # Run GHC with the toolchain's compile_env set, as every GHC command is.
    # The values are evaluated by the shell, as in ghc_env in compile.bzl.
    env_script = "".join(['export {}="{}"; '.format(name, value) for name, value in haskell_toolchain.compile_env.items()])

    def in_compile_env(cmd):
        return cmd_args("sh", "-c", env_script + 'exec "$@"', "sh", cmd) if env_script else cmd
    srcs = ctx.actions.symlinked_dir("srcs", {src.basename: src for src in ctx.attrs.srcs}, has_content_based_path = False)

    libdir = ctx.actions.declare_output("libdir")
    ctx.actions.run(
        in_compile_env(cmd_args("sh", "-c", 'out="$1"; shift; "$@" --print-libdir > "$out"', "sh", libdir.as_output(), haskell_toolchain.compiler)),
        category = "haskell_ghc_api_tool_libdir",
    )

    exe = ctx.actions.declare_output(ctx.attrs.name)
    ctx.actions.run(
        in_compile_env(cmd_args(
            "sh",
            "-c",
            'libdir=$(cat "$1"); shift; exec "$@" -outputdir "$BUCK_SCRATCH_PATH" "-DGHC_LIBDIR=\\"$libdir\\""',
            "sh",
            libdir,
            haskell_toolchain.compiler,
            "-v0",
            "-O",
            # Use only GHC's own packages, ignoring any package environment
            # file (one in the project, for example).
            "-package-env=-",
            "-hide-all-packages",
            [["-package", p] for p in GHC_API_TOOL_PACKAGES],
            cmd_args(srcs, format = "-i{}"),
            cmd_args(srcs, ctx.attrs.main, delimiter = "/"),
            "-o",
            exe.as_output(),
        )),
        category = "haskell_ghc_api_tool",
    )
    return [DefaultInfo(default_output = exe), RunInfo(args = cmd_args(exe))]

# The packages the tools use, all of which come with GHC.
GHC_API_TOOL_PACKAGES = ["base", "bytestring", "containers", "directory", "filepath", "ghc", "ghc-boot", "process"]

# The tools of the per-module compiles, by the name of their Main module. The
# tools' sources are in prelude//haskell/tools/ghc-api, and each source is
# also a target of prelude//haskell/tools, named after its path there.
GHC_API_TOOLS = {
    "per_module_compile": "PerModuleCompile",
    "per_module_deps": "PerModuleDeps",
}

# The modules that the tools share.
_SHARED_MODULES = ["DepFile", "Imports", "Interface", "Libdir", "Request"]

def ghc_api_tool_srcs(tool: str) -> dict[str, str]:
    """The `srcs` of a haskell_binary() that builds one of GHC_API_TOOLS,
    keyed by module name.

    A toolchain whose GHC is built from source can't use the tools that
    haskell_ghc_api_tool() builds, because they are linked with the GHC
    library of the GHC that builds them. It can build its own instead, as
    haskell_binary() targets that depend on the GHC library of the GHC that
    the toolchain runs, and pass them in the toolchain's `per_module_deps`
    and `per_module_compile`.
    """
    def src(module):
        return "prelude//haskell/tools:ghc-api/{}.hs".format(module)
    srcs = {module: src(module) for module in _SHARED_MODULES}
    srcs["Main"] = src(GHC_API_TOOLS[tool])
    return srcs

def ghc_api_tool_sources() -> list[str]:
    """The tools' source files, relative to prelude//haskell/tools."""
    return ["ghc-api/{}.hs".format(module) for module in _SHARED_MODULES + GHC_API_TOOLS.values()]

haskell_ghc_api_tool = rule(
    impl = _haskell_ghc_api_tool_impl,
    attrs = {
        # The program's modules. They must all be in the same directory,
        # which is the program's only source directory.
        "srcs": attrs.list(attrs.source()),
        # The file name of the Main module, which must be one of `srcs`.
        "main": attrs.string(),
        "_haskell_toolchain": toolchains_common.haskell(),
    },
)
