cabal-version:      3.0
name:               example
version:            0.1.0.0
build-type:         Simple
synopsis:           Fixture package exercising TH, hsc2hs and C++/FFI, used to test buck2/.

library
  exposed-modules:
      Example.TH
      Example.Point
      Example.Lib
  build-depends:
      base >=4 && <5
    , template-haskell
  default-extensions: TemplateHaskell, ForeignFunctionInterface
  include-dirs: cbits
  cxx-sources: cbits/shim.cpp
  cxx-options: -std=c++17
  default-language: Haskell2010

test-suite example-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends:
      base
    , example
  default-language: Haskell2010
